package examen;

import java.security.SecureRandom;
import java.util.Base64;
import javax.crypto.Cipher;
import javax.crypto.spec.IvParameterSpec;
import javax.crypto.spec.SecretKeySpec;

public final class cifrado {

private static final String CLAVE = "ClaveSecreta2026";
private static final SecureRandom sr = new SecureRandom();

public static String cifrar(String texto) {
try {
byte[] iv = new byte[16];
sr.nextBytes(iv);

Cipher cipher = Cipher.getInstance("AES/CBC/PKCS5PADDING");

SecretKeySpec sks = new SecretKeySpec(
CLAVE.getBytes("UTF-8"), "AES"
);

cipher.init(
Cipher.ENCRYPT_MODE,
sks,
new IvParameterSpec(iv)
);

byte[] encriptado = cipher.doFinal(
texto.getBytes("UTF-8")
);

String ivB64 = Base64.getEncoder().encodeToString(iv);
String msgB64 = Base64.getEncoder().encodeToString(encriptado);

return ivB64 + ":" + msgB64;

} catch (Exception e) {
return null;
}
}

public static String descifrar(String paquete) {
try {
if (paquete == null || !paquete.contains(":")) {
return null;
}

String[] partes = paquete.split(":", -1);

if (partes.length != 2) {
return null;
}

byte[] iv = Base64.getDecoder().decode(partes[0]);
byte[] datos = Base64.getDecoder().decode(partes[1]);

if (iv.length != 16) {
return null;
}

Cipher cipher = Cipher.getInstance("AES/CBC/PKCS5PADDING");

SecretKeySpec sks = new SecretKeySpec(
CLAVE.getBytes("UTF-8"), "AES"
);

cipher.init(
Cipher.DECRYPT_MODE,
sks,
new IvParameterSpec(iv)
);

byte[] dec = cipher.doFinal(datos);

return new String(dec, "UTF-8");

} catch (Exception e) {
return null;
}
}
}